* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #111111;
    color: #f5f5f5;
    line-height: 1.6;
}

header {
    background-color: #1c1c1c;
    text-align: center;
    padding: 50px 20px;
    border-bottom: 3px solid #e63946;
}

header h1 {
    font-size: 40px;
    margin-bottom: 10px;
}

header p {
    color: #cccccc;
}

main {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 20px;
}

section {
    background-color: #1c1c1c;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 10px;
}

h2 {
    color: #e63946;
    margin-bottom: 15px;
}

footer {
    text-align: center;
    padding: 25px;
    background-color: #1c1c1c;
    color: #aaaaaa;
}
nav {
    background-color: #080808;
    text-align: center;
    padding: 18px;
    border-bottom: 1px solid #333333;
}

nav a {
    color: #ffffff;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #e63946;
}
section img {
    width: 100%;
    max-width: 600px;
    height: auto;
    display: block;
    margin: 20px auto;
    border-radius: 10px;
}
section {
    transition: transform 0.3s ease, border-color 0.3s ease;
    border: 1px solid #292929;
}

section:hover {
    transform: translateY(-4px);
    border-color: #e63946;
}

a {
    transition: color 0.3s ease;
}

main ul {
    padding-left: 25px;
}

main li {
    margin-bottom: 12px;
}

main li a {
    color: #e63946;
    text-decoration: none;
}

main li a:hover {
    text-decoration: underline;
}

@media (max-width: 600px) {
    header h1 {
        font-size: 30px;
    }

    nav a {
        display: inline-block;
        margin: 6px 8px;
    }

    section {
        padding: 18px;
    }
}
