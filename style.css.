* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: #111111;
    color: #f5f5f5;
    line-height: 1.6;
}

header {
    background-color: #1c1c1c;
    text-align: center;
    padding: 50px 20px;
    border-bottom: 3px solid #e63946;
}

header h1 {
    font-size: 40px;
    margin-bottom: 10px;
}

header p {
    color: #cccccc;
}

main {
    max-width: 1000px;
    margin: 40px auto;
    padding: 0 20px;
}

section {
    background-color: #1c1c1c;
    padding: 25px;
    margin-bottom: 25px;
    border-radius: 10px;
}

h2 {
    color: #e63946;
    margin-bottom: 15px;
}

footer {
    text-align: center;
    padding: 25px;
    background-color: #1c1c1c;
    color: #aaaaaa;
}
nav {
    background-color: #080808;
    text-align: center;
    padding: 18px;
    border-bottom: 1px solid #333333;
}

nav a {
    color: #ffffff;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
}

nav a:hover {
    color: #e63946;
}
